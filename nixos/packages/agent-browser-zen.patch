+/// Extracts the Gecko version from a Firefox-style user agent (`rv:157.0`).
+pub fn gecko_version_from_user_agent(ua: &str) -> Option<String> {
+    let rest = &ua[ua.find("rv:")? + 3..];
+    let end = rest
+        .find(|c: char| !c.is_ascii_digit() && c != '.')
+        .unwrap_or(rest.len());
+    let version = &rest[..end];
+    version
+        .split('.')
+        .next()?
+        .parse::<u32>()
+        .ok()
+        .map(|_| version.to_string())
+}
